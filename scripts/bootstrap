#!/bin/bash
# First-time setup on a fresh Mac. The repo must already be cloned to
# ~/.config/nix (private repo, so that step needs your own auth). See README.md.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

echo "==> Checking for Xcode Command Line Tools..."
if ! xcode-select -p >/dev/null 2>&1; then
  echo "!! Command Line Tools not found."
  echo "   Run 'xcode-select --install', finish the popup, then re-run this script."
  exit 1
fi

echo "==> Checking for Nix..."
if ! command -v nix >/dev/null 2>&1; then
  echo "Installing Nix (Determinate installer)..."
  curl --proto '=https' --tlsv1.2 -sSf -L https://install.determinate.systems/nix | sh -s -- install
fi
# Make nix available in this shell without opening a new terminal.
if ! command -v nix >/dev/null 2>&1; then
  # shellcheck disable=SC1091
  . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi

echo "==> Applying configuration..."
if command -v darwin-rebuild >/dev/null 2>&1; then
  sudo darwin-rebuild switch --flake .#MacBook
else
  # darwin-rebuild doesn't exist until nix-darwin has been applied once.
  sudo nix run github:lnl7/nix-darwin#darwin-rebuild -- switch --flake .#MacBook
fi

echo "==> Done. Open a new terminal to pick up all changes."
