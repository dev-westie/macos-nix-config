#!/bin/bash
# Remove the quarantine flag from a specific app (or any file/folder) right
# away, without waiting for the next `darwin-rebuild switch`. The Dock/
# Gatekeeper/quarantine activation scripts in darwin/settings.nix already do
# this for everything in /Applications on every rebuild -- use this script
# for something you just downloaded and want to open immediately.
#
# Usage: ./unquarantine "/Applications/SomeApp.app"

set -e

if [ -z "$1" ]; then
  echo "Usage: $0 <path-to-app-or-file>"
  exit 1
fi

TARGET="$1"

if [ ! -e "$TARGET" ]; then
  echo "Not found: $TARGET"
  exit 1
fi

echo "Removing quarantine flag from: $TARGET"
xattr -dr com.apple.quarantine "$TARGET"
echo "Done."
